# Copy this file to .env.local in the repository root and fill in your own values.
# .env.local is git-ignored. Never commit real values.

# --- Database (used by scripts/setup_db.py, migrate_to_supabase.py, fit_driver_model.py, eval_agent.py)
# Postgres connection string of your Supabase project, for example:
#   postgresql://postgres:<password>@<host>:5432/postgres
SUPABASE_DB_URL=

# --- n8n (used by scripts/import_workflows.py and scripts/eval_agent.py)
# Address of your n8n, without a trailing /webhook
N8N_BASE_URL=https://your-n8n.example.com
# n8n -> Settings -> n8n API -> Create an API key
N8N_API_KEY=
# Ids of the two credentials you create in the n8n editor (the id is in the address bar when you open one)
N8N_POSTGRES_CREDENTIAL_ID=
N8N_LLM_CREDENTIAL_ID=
# Webhook base used by the eval script. Default is https://n8n.oi.destination.one/webhook
# N8N_WEBHOOK_BASE=https://your-n8n.example.com/webhook
